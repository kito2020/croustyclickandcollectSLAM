@model List<Restaurant>
@{
    ViewData["Title"] = "Nos restaurants";
    List<Restaurant> restaurantsCartographiables = Model.Where(r => r.CoordonneesValides).ToList();
}

<h1>Nos restaurants</h1>

@if (restaurantsCartographiables.Count > 0)
{
    <h2 class="h4 mt-4">Nous trouver</h2>
    <p class="text-muted">Cliquez sur un repère pour voir les informations du restaurant.</p>
    <div id="carte-restaurants" class="carte-restaurants rounded" role="region" aria-label="Carte des restaurants"></div>

    <div class="d-none" id="liste-restaurants-carte">
        @foreach (Restaurant restaurant in restaurantsCartographiables)
        {
            <div data-nom="@restaurant.Nom"
                 data-adresse="@restaurant.Adresse, @restaurant.CodePostal @restaurant.Ville"
                 data-latitude="@restaurant.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-longitude="@restaurant.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
        }
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        Aucun restaurant pour l'instant : écrivez le TODO S2-01 (Data/RestaurantRepository.cs).
    </div>
}

<div class="row g-3">
    @foreach (Restaurant restaurant in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">@restaurant.Nom</h2>
                    @* EstOuvertMaintenant est calculé par le controller (TODO S2-04). *@
                    @if (restaurant.EstOuvertMaintenant)
                    {
                        <span class="badge text-bg-success">Ouvert</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Fermé</span>
                    }
                    <p class="mt-2 mb-1">@restaurant.Adresse<br />@restaurant.CodePostal @restaurant.Ville</p>
                    <p class="mb-1">Tél. @restaurant.Telephone</p>
                    <p class="mb-0">
                        Tous les jours de @(restaurant.HeureOuverture.ToString("hh\\:mm"))
                        à @(restaurant.HeureFermeture.ToString("hh\\:mm"))
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@if (restaurantsCartographiables.Count > 0)
{
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/restaurants.js" asp-append-version="true"></script>
}

@section Styles {
    @if (restaurantsCartographiables.Count > 0)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
}
