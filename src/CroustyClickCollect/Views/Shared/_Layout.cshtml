@* =====================================================================
   La mise en page commune à toutes les pages : menu en haut, pied de page.
   Le contenu de chaque page s'affiche à l'endroit de @RenderBody().
   ===================================================================== *@
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Tasty Crousty</title>
    @* Bootstrap : une bibliothèque CSS prête à l'emploi (classes « btn », « table », « card »…).
       Elle est chargée depuis Internet : rien à installer. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bandeau">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Tasty Crousty</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Carte" asp-action="Index">La carte</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Restaurants" asp-action="Index">Nos restaurants</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Panier" asp-action="Index">Mon panier</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuisine" asp-action="Index">Écran cuisine</a></li>
                            <li class="nav-item">
                                <form asp-controller="Compte" asp-action="Deconnexion" method="post">
                                    <button type="submit" class="btn btn-link nav-link">Se déconnecter (@User.Identity.Name)</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Compte" asp-action="Connexion">Espace personnel</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @* Message court affiché après une action (« ajouté au panier »…). *@
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">@TempData["Message"]</div>
        }

        @RenderBody()
    </main>

    <footer class="pied border-top py-3 mt-5">
        <div class="container small d-flex flex-wrap gap-3 justify-content-between">
            @* TODO S1-02 (sprint 1) : signer le site avec le nom de votre équipe.
                 Consigne : remplacer « Nom de l'équipe » par le vrai nom de votre équipe.
                 Indice   : c'est du HTML simple ; enregistrez, puis rechargez la page. *@
            <span>© 2026 Tasty Crousty · Site réalisé par l'équipe <strong> BK_est_meilleur</strong></span>
            <span>
                <a asp-controller="Home" asp-action="MentionsLegales">Mentions légales</a> ·
                <a asp-controller="Home" asp-action="Confidentialite">Confidentialité</a> ·
                <a asp-controller="Home" asp-action="Cgv">Conditions de vente</a>
            </span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @* Les pages qui ont besoin de leur propre JavaScript le placent dans une section « Scripts ». *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
